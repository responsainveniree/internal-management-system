// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Enum
enum Role {
  ADMIN
  HOTEL_MANAGER
  SUPERVISOR
  ACCOUNTANT
  HOUSEKEEPING
  FRONT_DESK
}

enum LocationType {
  MAIN_WAREHOUSE
  FLOOR_LOCKER
  FRONT_OFFICE
  OPERATIONAL
  VENDOR_LAUNDRY
  GUEST_ROOM
}

enum StockType {
  READY
  DIRTY
  DAMAGED
  EXPIRED
  LOST
}

enum MovementType {
  RECEIVE
  TRANSFER
  CONSUME
  SALE
  DISCARD
  LAUNDRY_OUT
  LAUNDRY_IN
  ADJUSTMENT
  MARK_AS_DAMAGED
  MARK_AS_DIRTY
  MARK_AS_EXPIRED
  MARK_AS_LOST
}

enum LaundryStatus {
  SENT
  RETURNED
  CANCELLED
}

enum StockRequestType {
  ISSUE // Standard checkout for usage
  RESTOCK // Replenishing storage levels
  TRANSFER // Moving stock between locations
  SALE // Direct customer sale
  WRITE_OFF // Reporting damaged, expired, or discarded stock
  REPORT_LOST // Reporting missing/lost stock
  LAUNDRY_IN
  LAUNDRY_OUT
}

enum StockRequestStatus {
  PENDING
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
}

enum UserAction {
  CREATE
  UPDATE
  DELETE
}

enum Entity {
  USER
  ACCOUNT
  SESSION
  VERIFICATION_TOKEN
  LOCATION
  CATEGORY
  ITEM
  STOCK
  STOCK_MOVEMENT
  STOCK_REQUEST
  ORDER
  ORDER_ITEM
  LAUNDRY
}

// Notification Subscription
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Acount creation
model User {
  id            String          @id @default(cuid())
  name          String
  email         String          @unique
  password      String
  emailVerified DateTime?
  image         String?
  role          Role
  accounts      Account[]
  sessions      Session[]
  // Optional for WebAuthn support
  Authenticator Authenticator[]

  createdCategories      Category[]      @relation("CategoryCreator")
  updatedCategories      Category[]      @relation("CategoryUpdater")
  createdItems           Item[]          @relation("ItemsCreator")
  updatedItems           Item[]          @relation("ItemsUpdater")
  createdLocations       Location[]      @relation("LocationCreator")
  updatedLocations       Location[]      @relation("LocationUpdater")
  createdStocks          Stock[]         @relation("StockCreator")
  updatedStocks          Stock[]         @relation("StockUpdater")
  requestedStockRequests StockRequest[]  @relation("StockRequestsRequested")
  approvedStockRequests  StockRequest[]  @relation("StockRequestsApproved")
  orders                 Order[]
  logs                   AuditLog[]
  stockMovements         StockMovement[]

  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)
  pushSubscriptions PushSubscription[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// Optional for WebAuthn support
model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

// Inventor Core Model
model Location {
  id          String       @id @default(cuid())
  name        String       @unique
  type        LocationType
  description String?

  stocks            Stock[]
  incomingMovements StockMovement[] @relation("Destination")
  outgoingMovements StockMovement[] @relation("Source")

  outGoinglaundries Laundry[] @relation("LaundrySource")
  inComingLaundries Laundry[] @relation("LaundryDestination")

  createdBy               String
  userCreatedBy           User           @relation("LocationCreator", fields: [createdBy], references: [id])
  updatedBy               String?
  userUpdatedBy           User?          @relation("LocationUpdater", fields: [updatedBy], references: [id])
  StockRequestSource      StockRequest[] @relation("StockRequestSource")
  StockRequestDestination StockRequest[] @relation("StockRequestDestination")

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model Category {
  id    String @id @default(cuid())
  name  String @unique
  items Item[]

  createdBy     String?
  updatedBy     String?
  userCreatedBy User?   @relation("CategoryCreator", fields: [createdBy], references: [id])
  userUpdatedBy User?   @relation("CategoryUpdater", fields: [updatedBy], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model Item {
  id               String  @id @default(cuid())
  name             String  @unique
  image            String?
  description      String
  sellingPrice     Int?
  costPrice        Int
  attributes       Json?
  minThreshold     Int     @default(0)
  requiresApproval Boolean @default(true)
  isActive         Boolean @default(true)

  stockMovements StockMovement[]
  categoryId     String?
  category       Category?       @relation(fields: [categoryId], references: [id])

  createdBy     String
  updatedBy     String?
  userCreatedBy User    @relation("ItemsCreator", fields: [createdBy], references: [id])
  userUpdatedBy User?   @relation("ItemsUpdater", fields: [updatedBy], references: [id])

  stocks     Stock[]
  orderItems OrderItem[]
  laundries  Laundry[]

  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)
  stockRequests StockRequest[] @relation("ItemStockRequests")
}

model Stock {
  id        String    @id @default(cuid())
  quantity  Int       @default(0)
  totalCost Int       @default(0)
  type      StockType @default(READY)
  expiredAt DateTime?

  itemId     String
  item       Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  locationId String
  location   Location? @relation(fields: [locationId], references: [id])

  createdBy String
  creator   User    @relation("StockCreator", fields: [createdBy], references: [id])
  updatedBy String?
  updater   User?   @relation("StockUpdater", fields: [updatedBy], references: [id])

  movements StockMovement[]

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  laundries Laundry[] @relation("VendorLaundryStock")

  @@index([itemId, locationId, type, expiredAt])
}

// Logistic and movement tracking
model StockMovement {
  id        String       @id @default(cuid())
  quantity  Int
  totalCost Int?
  type      MovementType
  reason    String

  itemId   String
  itemName String
  item     Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  sourceLocationId      String?
  sourceLocation        Location? @relation("Source", fields: [sourceLocationId], references: [id])
  destinationLocationId String?
  destinationLocation   Location? @relation("Destination", fields: [destinationLocationId], references: [id])

  stockId        String?
  stock          Stock?        @relation(fields: [stockId], references: [id])
  orderId        String?
  order          Order?        @relation(fields: [orderId], references: [id])
  stockRequestId String?       @unique
  stockRequest   StockRequest? @relation(fields: [stockRequestId], references: [id])

  createdBy String
  user      User   @relation(fields: [createdBy], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model StockRequest {
  id String @id @default(cuid())

  itemId String
  item   Item   @relation("ItemStockRequests", fields: [itemId], references: [id])

  requestedById String
  requestedBy   User   @relation("StockRequestsRequested", fields: [requestedById], references: [id])

  approvedById String?
  approvedBy   User?   @relation("StockRequestsApproved", fields: [approvedById], references: [id])

  sourceLocationId String?
  sourceLocation   Location? @relation("StockRequestSource", fields: [sourceLocationId], references: [id])

  destinationLocationId String
  destinationLocation   Location @relation("StockRequestDestination", fields: [destinationLocationId], references: [id])

  requestedQuantity Int
  approvedQuantity  Int @default(0)

  type   StockRequestType   @default(ISSUE)
  status StockRequestStatus @default(PENDING)

  reason String

  // Rejection tracking
  decisionNotes String?

  // Relation to execution ledger
  stockMovement StockMovement?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model Laundry {
  id String @id @default(cuid())

  quantity          Int
  totalLaundryPrice Int?
  status            LaundryStatus @default(SENT)
  reason            String?

  sentAt     DateTime  @default(now())
  returnedAt DateTime?

  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  sourceLocationId String?
  sourceLocation   Location? @relation("LaundrySource", fields: [sourceLocationId], references: [id])

  destinationLocationId String?
  destinationLocation   Location? @relation("LaundryDestination", fields: [destinationLocationId], references: [id])

  vendorLaundryStockId String
  vendorLaundryStock   Stock  @relation("VendorLaundryStock", fields: [vendorLaundryStockId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([itemId])
  @@index([status])
}

// Internal Transaction / Extra Orders (later to work)
model Order {
  id             String  @id @default(cuid())
  roomNumber     String?
  guestName      String?
  totalAmount    Int     @default(0)
  isBilledToRoom Boolean @default(true)

  items          OrderItem[]
  stockMovements StockMovement[]

  createdBy String
  user      User   @relation(fields: [createdBy], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model OrderItem {
  id          String @id @default(cuid())
  quantity    Int
  priceAtSale Int

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId  String
  item    Item   @relation(fields: [itemId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

// Log Audit
model AuditLog {
  id       String     @id @default(cuid())
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  action   UserAction
  entity   Entity
  entityId String

  metadata  Json
  timestamp DateTime @default(now())
}
